# Supabase — get these from your project settings at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://daahzybrfmlotpoigmtt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Stripe — get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Danish (DKK) subscription price. Leave blank to bill via an inline price.
STRIPE_PRICE_SOCIAL_MONTHLY=
# Optional EUR subscription price for non-Danish languages. Leave blank to
# bill via an inline EUR price instead of a pre-created Stripe Price.
STRIPE_PRICE_SOCIAL_MONTHLY_EUR=

# Higgsfield — get from https://higgsfield.ai
HIGGSFIELD_API_KEY=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://some-rental123.vercel.app

# Google Analytics 4 — Measurement ID from https://analytics.google.com
# (Admin → Data streams → your web stream). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification token from the "HTML tag" method at
# https://search.google.com/search-console (the content="..." value only).
# Leave blank to omit the verification meta tag.
GOOGLE_SITE_VERIFICATION=
